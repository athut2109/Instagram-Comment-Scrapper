# Example env vars for local development
# POC_API_KEY can be used to bootstrap a single global key (legacy/backwards compat).
# For DB-backed keys use the scripts/generate_api_key.py script.
# POC_API_KEY=your_legacy_key_here
# POC_ADMIN_KEY=your_admin_key_here   # optional: an admin-only override
POC_RATE_LIMIT=20
POC_RATE_WINDOW=60
POC_SYNC_TIMEOUT=30
API_KEY_PBKDF2_ITER=100000
# DB path default is insta_poc.db
# POC_DB_PATH=insta_poc.db